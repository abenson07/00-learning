# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
#
# Prefer `.env.local` in the project root (same folder as `package.json`).
# After changing env, restart `next dev`.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Also accepted (use any one key the dashboard shows):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
#
# Server-only fallbacks (optional; work for server components / middleware, not the browser bundle):
# SUPABASE_URL=...
# SUPABASE_ANON_KEY=...
